  },
  {
    "id": "afternoon-c-06",
    "slot": "afternoon",
    "role": "close",
    "text": "记得活动一下肩膀。"
  },
  {
    "id": "afternoon-c-07",
    "slot": "afternoon",
    "role": "close",
