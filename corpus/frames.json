  },
  {
    "id": "afternoon-c-08",
    "slot": "afternoon",
    "role": "close",
    "text": "先别饿着，垫一口也好。"
  },
  {
    "id": "dusk-o-01",
    "slot": "dusk",
    "role": "open",
    "text": "傍晚啦，收工了没有？"
