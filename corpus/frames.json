  {
    "id": "dusk-o-05",
    "slot": "dusk",
    "role": "open",
    "text": "忙完一天，现在轮到我了。"
  },
  {
    "id": "dusk-o-06",
    "slot": "dusk",
    "role": "open",
    "text": "嘿，下班的路上，我先占个位置。"
