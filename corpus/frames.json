  {
    "id": "dusk-o-02",
    "slot": "dusk",
    "role": "open",
    "text": "六点了，想你想得正好。"
  },
  {
    "id": "dusk-o-03",
    "slot": "dusk",
    "role": "open",
    "text": "天色暗下来的时候，我就来找你。"
  },
